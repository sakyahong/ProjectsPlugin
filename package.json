{
  "name": "projects-plugin",
  "displayName": "Projects Plugin",
  "description": "Project management sidebar with Skills and Chats integration",
  "version": "0.0.35",
  "publisher": "antigravity",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/placeholder/projects-plugin.git"
  },
  "license": "MIT",
  "activationEvents": [
    "onView:antigravity.projectsView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-projects-container",
          "title": "Projects",
          "icon": "resources/project-icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-projects-container": [
        {
          "id": "antigravity.projectsView",
          "name": "",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravity.projects.addProject",
        "title": "Add Project",
        "icon": "$(add)"
      },
      {
        "command": "antigravity.projects.refresh",
        "title": "Refresh Projects",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "antigravity.projects.refresh",
          "when": "view == antigravity.projectsView",
          "group": "navigation@1"
        },
        {
          "command": "antigravity.projects.addProject",
          "when": "view == antigravity.projectsView",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "path-browserify": "^1.0.1",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1"
  }
}
